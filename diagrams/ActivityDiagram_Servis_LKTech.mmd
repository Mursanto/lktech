    S8D["Tambahkan Part\nke Tiket Servis"]
    S8D --> S8E["Kurangi Stok\nProduk (service_parts)"]
    S8E --> S9

    S8 -->|Tidak| S9

    S9["Perbaikan Selesai"] --> S10
